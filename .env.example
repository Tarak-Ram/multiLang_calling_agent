# Copy to .env. Secrets come ONLY from the environment; never commit .env.
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0

# WhatsApp Cloud API (Step 3)
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0

# LLM models. These only SEED the first profile (`default`) on first boot; after that, switch
# models any time with `python -m assistant.llm.cli activate NAME` (see README). Model names are
# LiteLLM ids such as provider/model-name.
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
LLM_FALLBACK_MODEL=
LLM_MAX_OUTPUT_TOKENS=150
# Provider API keys are read by LiteLLM straight from the environment, e.g. ANTHROPIC_API_KEY,
# OPENAI_API_KEY, GEMINI_API_KEY (set only the one(s) you use). Empty LLM_FAST_MODEL = rules-only.
EMBEDDING_MODEL=               # LiteLLM embedding model id; empty disables semantic cache
EMBEDDING_DIM=1024             # must match the kb_chunks.embedding column

ADMIN_API_KEY=                 # empty = /admin/* disabled. Long random string for the handoff inbox + cost report
GOOGLE_SERVICE_ACCOUNT_FILE=   # optional: mirror bookings into Google Calendar (see tools/calendar.py)
LANGFUSE_HOST=                 # optional: push turn traces to a Langfuse server (empty = logs only)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

RATE_LIMIT_PER_MINUTE=60
SHUTDOWN_GRACE_SECONDS=20
